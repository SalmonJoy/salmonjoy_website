---
import Icon from './Icon.astro';
import type {TrackId} from '../data/training';
interface Props {selectedTrack?:TrackId;}
const {selectedTrack}=Astro.props;
---
<form id="enquiry-form" class="enquiry-form">
  <div class="fallback-contact"><p>Let’s discuss your team’s AI training.</p><a class="button button-ivory" href="mailto:salmonjoy1996@gmail.com">Email Salmon <Icon name="mail"/></a><a class="text-link" href="https://wa.me/919029964453">Continue on WhatsApp <Icon/></a></div>
  <div class="form-row"><label>Your name<input name="name" autocomplete="name" placeholder="Alex Morgan" maxlength="100" required /></label><label>Organization<input name="organization" autocomplete="organization" placeholder="Company or institution" maxlength="150" required /></label></div>
  <div class="form-row"><label>What are you interested in?<select name="track"><option value="choose" selected={!selectedTrack}>Help me choose</option><option value="work" selected={selectedTrack==='work'}>AI at Work</option><option value="build" selected={selectedTrack==='build'}>Build with GenAI</option><option value="teach" selected={selectedTrack==='teach'}>Teach AI</option><option value="consulting">AI consulting / speaking</option></select></label><label>Team size<select name="size"><option value="Not decided yet">Not decided yet</option><option>1–10 people</option><option>11–50 people</option><option>51+ people</option></select></label></div>
  <label>What would you like your team to be able to do?<textarea name="goal" rows="3" placeholder="Tell me a little about your team and what you have in mind…" maxlength="1200" required></textarea></label>
  <button class="button button-ivory" type="submit">Prepare your enquiry <Icon name="arrow" /></button>
  <p class="form-note">A conversation starts here. You’ll review your message before sending it through email or WhatsApp.</p>
  <section id="message-preview" class="message-preview" hidden aria-labelledby="preview-title">
    <h3 id="preview-title" tabindex="-1">Your message, ready to go.</h3>
    <p>Choose where you’d like to send it. Nothing has been sent yet.</p>
    <pre id="prepared-message" tabindex="0"></pre>
    <div class="message-actions"><a id="email-enquiry" class="button button-ivory" href="mailto:salmonjoy1996@gmail.com">Prepare email <Icon name="mail" /></a><a id="whatsapp-enquiry" class="button button-outline" href="https://wa.me/919029964453" target="_blank" rel="noopener noreferrer">Continue on WhatsApp <Icon /></a><button class="text-link" id="copy-message" type="button">Copy message</button></div>
    <p id="copy-status" role="status" class="form-note"></p>
  </section>
  <noscript><p>Contact me directly at <a href="mailto:salmonjoy1996@gmail.com">salmonjoy1996@gmail.com</a> or <a href="https://wa.me/919029964453">WhatsApp</a>.</p></noscript>
</form>
