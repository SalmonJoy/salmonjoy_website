---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import {insights} from '../../data/articles';
import {tracks} from '../../data/training';
import {featured} from '../../data/content';
import {SITE,PERSON_ID} from '../../data/seo';
export function getStaticPaths(){return insights.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article:a}=Astro.props;
const path=`/insights/${a.slug}/`;
const breadcrumbs=[{name:'Home',path:'/'},{name:'Insights',path:'/insights/'},{name:a.title,path}];
const entity={'@type':'Article','@id':SITE+path+'#article',headline:a.title,description:a.description,author:{'@id':PERSON_ID},publisher:{'@id':PERSON_ID},image:SITE+a.image,url:SITE+path,inLanguage:'en',articleSection:a.topic,mainEntityOfPage:{'@id':SITE+path+'#webpage'},citation:a.sources.map(s=>new URL(s.url,SITE).href),...(a.publishedAt?{datePublished:a.publishedAt}:{}),...(a.modifiedAt?{dateModified:a.modifiedAt}:{})};
---
<Layout title={`${a.title} | Salmon Joy`} description={a.description} image={a.image} imageAlt={a.imageAlt} breadcrumbs={breadcrumbs} entities={[entity]} publishedAt={a.publishedAt} modifiedAt={a.modifiedAt}>
<article><header class="editorial-hero dark-scene article-hero"><Breadcrumbs items={breadcrumbs}/><span class="eyebrow">{a.topic}</span><h1>{a.title}</h1><p>{a.answer}</p><div class="article-byline"><a href="/about/">By {a.author}</a>{a.publishedAt&&<time datetime={a.publishedAt}>{new Intl.DateTimeFormat('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(a.publishedAt))}</time>}{a.modifiedAt&&<span>Updated <time datetime={a.modifiedAt}>{a.modifiedAt}</time></span>}</div></header><div class="editorial-wrap article-layout"><aside class="article-toc"><nav aria-label="In this guide"><span class="eyebrow">IN THIS GUIDE</span><ol>{a.sections.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol></nav><a href="/training/" class="text-link">Find a training path <Icon/></a></aside><div class="reading-copy article-copy"><img class="article-cover" src={a.image} width="1200" height="630" alt={a.imageAlt}/>{a.sections.map(s=><section id={s.id} class="content-section"><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}{s.prompt&&<div class="prompt-example"><span class="eyebrow">EXAMPLE PROMPT</span><pre>{s.prompt.replaceAll('\\n','\n')}</pre></div>}{s.callout&&<aside class="article-callout">{s.callout}</aside>}</section>)}<section class="article-sources"><h2>Sources & further reading</h2><ul>{a.sources.map(s=><li><a href={s.url}>{s.label} ↗</a></li>)}</ul></section><div class="author-card"><img src="/images/portrait.webp" width="80" height="80" alt="Salmon Joy" loading="lazy"/><div><strong><a href="/about/">Salmon Joy</a></strong><p>AI engineer and enterprise trainer. 8+ years of experience; 10,000+ learners trained.</p></div></div><section class="related-reading"><h2>Put the idea into practice.</h2>{tracks.filter(t=>a.relatedServices.includes(t.id)).map(t=><a class="resource-link" href={t.url}><strong>{t.title}</strong><span>{t.description}</span><Icon/></a>)}{featured.filter(p=>a.relatedProjects.includes(p.slug)).map(p=><a class="text-link" href={`/projects/${p.slug}/`}>{p.description} case study <Icon/></a>)}</section></div></div></article>
</Layout>
