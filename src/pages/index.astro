---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Enquiry from '../components/Enquiry.astro';
import Architecture from '../components/Architecture.astro';
import { tracks, featured } from '../data/content';
import {insights} from '../data/articles';
const milestones = [
 ['2014—2018','An engineer’s curiosity','Mechanical Engineering, Fr. Conceicao Rodrigues Institute of Technology.'],
 ['2018—2024','Making technology accessible','AI training at AutoDice, engineering at Smartbyte Computer Education, and independent training.'],
 ['2022—2024','From ideas to implementation','AI and ML Consultant at Accennovate Tech Solutions.'],
 ['2024—2025','Building a culture of learning','Artificial Intelligence and Machine Learning Expert at GITAM.'],
 ['2025—PRESENT','Engineering in the real world','AI Engineer at GRAVITY — Hyper-Personalization Banking Platform.'],
 ['CURRENT CHAPTER','Helping teams apply AI','Master Trainer for the OpenAI Programme in India through VMS Group APAC and Channel Partners Solutions, LLC.'],
];
---
<Layout home>
  <section class="hero dark-scene" id="arrival" data-nori-scene="hero">
    <div class="hero-orbit" aria-hidden="true"></div>
    <div class="hero-content"><p class="eyebrow hero-eyebrow"><span class="status-dot"></span> FROM CURIOSITY TO CAPABILITY</p><h1>Salmon Joy.<br/>AI, made<br/><em>practical.</em></h1><p class="hero-credential">OpenAI Programme Master Trainer<br/><span>AI Engineer · Enterprise AI Trainer</span></p><p class="hero-description">I help teams turn AI curiosity into practical skills and working solutions.</p><div class="hero-actions"><a class="button button-ivory" href="#contact">Discuss team training <Icon /></a><a class="text-link" href="#work">Explore my work <span>↗</span></a></div></div>
    <div class="hero-visual"><div class="portrait-frame"><img src="/images/portrait.webp" alt="Salmon Joy wearing his signature burgundy blazer." width="800" height="800" fetchpriority="high"/><span class="portrait-corner" aria-hidden="true">SJ / 01</span></div><div class="portrait-label"><span>ENGINEER BY PRACTICE.<br/>EDUCATOR BY INSTINCT.</span><Icon name="spark" size={30}/></div><div class="hero-nori"><span class="nori-anchor" aria-hidden="true"></span><span class="nori-note">A little curiosity<br/>goes a long way. <i>↖</i></span></div></div>
    <div class="hero-bottom"><span>MUMBAI, INDIA · IDEAS WITHOUT BORDERS</span><a href="#credibility">SCROLL TO EXPLORE <span>↓</span></a></div>
  </section>
  <section class="credibility section-pad" id="credibility" data-nori-scene="proof"><div class="section-kicker"><span>01 / BUILT ON EXPERIENCE</span><span>HUMAN CONNECTION. PRACTICAL AI.</span></div><div class="metrics"><div><strong>10,000<span>+</span></strong><p>Learners trained</p></div><div><strong>8<span>+</span></strong><p>Years of experience</p></div><div><strong>21</strong><p>Projects across AI & engineering</p></div></div><div class="programme-grid"><div><p class="eyebrow">A PROGRAMME. A PRACTICAL MISSION.</p><h2>OpenAI knowledge.<br/><em>Real-world capability.</em></h2></div><div class="programme-copy"><p>As a <strong>Master Trainer for the OpenAI Programme in India</strong>, I help professionals move from exploring AI to using it with confidence.</p><p class="small-copy">Programme delivered through VMS Group APAC and Channel Partners Solutions, LLC.</p><a class="text-link" href="https://www.linkedin.com/feed/update/urn:li:activity:7521572079490707458/" target="_blank" rel="noopener noreferrer">See a recent training engagement <Icon size={18}/></a></div></div><div class="org-strip"><span>SELECTED TRAINING ENGAGEMENTS</span><div>Techanzy <i>✦</i> Tata International <i>✦</i> Ajanta Pharma</div></div></section>
  <section class="teaching section-pad" id="teaching" data-nori-scene="teaching"><div class="section-kicker"><span>02 / A SMALL MOMENT OF CLARITY</span><a href="#training">SKIP DEMONSTRATION ↓</a></div><div class="section-heading"><h2>Good AI finds an answer.<br/>Useful AI finds <em>its evidence.</em></h2><p>Complex ideas can feel simple.<br/>Here’s how I explain retrieval-augmented generation.</p></div><div class="teaching-layout"><div class="teaching-stage"><div class="stage-top"><span class="status-dot"></span> THE EVIDENCE LAB <span>RAG / 001</span></div><div class="question-bubble">“Can I work remotely on Fridays?”<span>A question from an employee</span></div><div class="source-cards"><div class="ghost-doc"></div><div class="policy-document"><div><Icon name="spark" size={18}/><span>TEAM HANDBOOK</span><span>§ 4.2</span></div><h3>Flexible working policy</h3><p>Our working arrangements support collaboration and flexibility.</p><mark>Employees may work remotely up to two days per week with manager approval.</mark><div class="document-lines" aria-hidden="true"><i></i><i></i></div></div></div><div class="evidence-answer"><span>ANSWER, WITH A SOURCE</span><p>Yes—with your manager’s approval, within the two-day weekly allowance. <a href="#policy-source" aria-label="Read illustrative policy source">[1]</a></p></div><div class="stage-foot"><span class="nori-anchor" aria-hidden="true"></span><p>Less guesswork.<br/><em>More grounding.</em></p><span class="lab-progress">01 <i></i> 03</span></div><div class="step-controls" aria-label="Demonstration steps">{['Ask','Retrieve','Answer'].map((s,i)=><button type="button" data-demo-step={i} aria-pressed={i===0}>{String(i+1).padStart(2,'0')} {s}</button>)}</div><small id="policy-source">Illustrative demonstration. Fictional policy and answer.</small></div><div class="teaching-steps">{[
 ['First, ask a real question.','A useful answer starts with a clear question. The model needs the company’s policy—not just its general knowledge.','QUESTION → CONTEXT'],
 ['Then, find the right source.','Retrieval brings in the relevant passage from the handbook. We give the model the information it needs to answer.','SEARCH → RELEVANT PASSAGE'],
 ['Connect the answer to evidence.','The answer points back to its source. You can inspect the evidence, understand the limits, and decide what to do next.','ANSWER → VERIFIABLE SOURCE'],
].map(([title,copy,label],i)=><article class="teaching-step" data-step={i}><span class="step-number">0{i+1}</span><div><span class="eyebrow">{label}</span><h3>{title}</h3><p>{copy}</p><div class="mobile-demo-panel">{i===0?<div class="mobile-question">“Can I work remotely on Fridays?”<small>A fictional employee question</small></div>:i===1?<div class="mobile-policy" id="mobile-policy"><span>TEAM HANDBOOK · § 4.2</span><p>Employees may work remotely <mark>up to two days per week with manager approval.</mark></p></div>:<div class="mobile-answer"><span>ANSWER, WITH A SOURCE</span><p>Yes—with your manager’s approval, within the two-day weekly allowance. <a href="#mobile-policy">[1]</a></p></div>}<div class="mobile-demo-footer"><span class="nori-anchor" aria-hidden="true"></span><small>Illustrative example.<br/>Fictional company policy.</small></div></div><button class="text-link replay-step" data-demo-step={i}>Show this step <span>↗</span></button></div></article>)}</div></div></section>
  <section class="training section-pad" id="training" data-nori-scene="training"><div class="section-kicker"><span>03 / LEARNING THAT GOES SOMEWHERE</span><span>HANDS ON. MINDS ON.</span></div><div class="section-heading"><h2>Your next chapter<br/>starts with <em>a little AI.</em></h2><p>Different teams. Different starting points.<br/>A practical path for each.</p></div><p class="delivery-note">On-site workshops across India · Live online for teams worldwide. <a href="/training/">Compare training paths →</a></p><div class="training-grid">{tracks.map((track,i)=><article class="training-card" data-training-card={track.id}><div class="track-top"><span>{track.number}</span><Icon name="spark" size={22}/></div><div class:list={['track-art',`track-art-${track.id}`]} aria-hidden="true">{i===0?<><span class="mini-window">Your workflow<i></i><i></i><b>+ AI →</b></span><span class="art-spark">✦</span></>:i===1?<><span class="build-chip">&lt;/&gt;</span><span class="build-line"></span><span class="build-chip second">✦</span><span class="build-tag">BUILD · TEST · IMPROVE</span></>:<><span class="teach-board">a little <em>aha!</em><i>○ → ✦ → ∞</i></span></>}</div><span class="eyebrow">{track.audience}</span><h3>{track.title}</h3><p>{track.description}</p><details open={i===0}><summary>What your team will learn <Icon name="plus" size={18}/></summary><ul>{track.outcomes.map(outcome=><li>{outcome}</li>)}</ul></details><div class="tags">{track.topics.map(t=><span>{t}</span>)}</div><a class="text-link programme-detail" href={track.url}>Explore this programme <Icon size={18}/></a><a class="text-link track-enquiry" data-track={track.id} href="#contact">Discuss this programme <Icon size={18}/></a></article>)}</div><div class="training-help"><p>Not sure where to begin? <span>Nori can help find your path.</span></p><button data-open-guide class="button button-outline">Find a workshop <Icon /></button></div></section>
  <section class="work dark-scene section-pad" id="work" data-nori-scene="work"><span id="projects" class="legacy-anchor" aria-hidden="true"></span><span id="skills" class="legacy-anchor" aria-hidden="true"></span><div class="section-kicker"><span>04 / ENGINEERING MEETS EDUCATION</span><span>SELECTED WORK, 01—03</span></div><div class="section-heading"><h2>I teach<br/>what I <em>build.</em></h2><p>The best explanations come from doing.<br/>A few things I’ve put into practice.</p></div><div class="work-layout"><div class="work-stage"><div class="architecture-set">{featured.map((_,i)=><div data-work-visual={i} class:list={['work-visual',{active:i===0}]}><Architecture variant={i}/></div>)}</div><div class="work-stage-footer"><span class="nori-anchor" aria-hidden="true"></span><p>FROM CONCEPT<br/>TO WORKING SYSTEM.</p></div></div><div class="case-list">{featured.map((p,i)=><article class="case-card" data-case={i}><div class="case-number">0{i+1} <span>{p.description}</span></div><div class="mobile-architecture"><Architecture variant={i} compact/></div><h3>{p.title}</h3><p>{p.approach}</p><div class="case-result"><strong>{p.metric}</strong><span>{p.metricLabel}<small>Reported project outcome</small></span></div><div class="tags">{p.stack.map(s=><span>{s}</span>)}</div><a href={`/projects/${p.slug}/`} class="text-link">Inside the project <Icon /></a></article>)}</div></div><a class="all-work-link" href="/projects/"><span>There’s more where that came from.</span><strong>Explore all 21 projects <Icon size={38}/></strong></a></section>
  <section class="proof section-pad" id="people"><div class="section-kicker"><span>05 / IN GOOD COMPANY</span><span>REAL ROOMS. REAL CURIOSITY.</span></div><div class="section-heading"><h2>Technology is the topic.<br/><em>People are the point.</em></h2><p>The questions. The first working prototype.<br/>That moment when something clicks.</p></div><div class="photo-grid"><figure class="photo-main"><img src="/images/workshop-acpatil.webp" width="1080" height="810" loading="lazy" alt="Salmon Joy with participants at the A C Patil College AI and machine learning workshop."/><figcaption><span>LEARNING, TOGETHER.</span><a href="https://www.linkedin.com/feed/update/urn:li:activity:7164637706701029376/" target="_blank" rel="noopener noreferrer">A C Patil College of Engineering ↗</a></figcaption></figure><figure class="photo-tall"><img src="/images/workshop-thakur.webp" width="800" height="1066" loading="lazy" alt="Salmon explaining a topic beside a projection screen at Thakur Shyamnarayan Degree College."/><figcaption><span>FROM THEORY TO “I GET IT.”</span><a href="https://www.linkedin.com/feed/update/urn:li:activity:7142898496138874880/" target="_blank" rel="noopener noreferrer">Thakur Shyamnarayan Degree College ↗</a></figcaption></figure><figure class="photo-small"><img src="/images/workshop-fcrit.webp" width="508" height="381" loading="lazy" alt="Salmon teaching AI and machine learning in a computer lab at FCRIT."/><figcaption><span>HANDS ON, FROM DAY ONE.</span><a href="https://www.linkedin.com/feed/update/urn:li:activity:7151581438247591937/" target="_blank" rel="noopener noreferrer">FCRIT · AI & ML workshop ↗</a></figcaption></figure></div><div class="testimonials">{[
 ['Salmon has been a great resource for me and my team','Monu Shetty','CTO, Maximus Technolabs'],['an exceptional educator and trainer','Mehul Shah','Learning & Development leader'],['making complex concepts accessible','Anmolika Saxena','Talent acquisition professional']
].map(([quote,name,role])=><figure><span class="quote-mark">“</span><blockquote>{quote}</blockquote><figcaption><strong>{name}</strong><span>{role}</span><a href="https://www.linkedin.com/in/salmonjoy/details/recommendations/" target="_blank" rel="noopener noreferrer">Read recommendation ↗</a></figcaption></figure>)}</div><a class="text-link" href="https://www.linkedin.com/feed/update/urn:li:activity:7521572079490707458/" target="_blank" rel="noopener noreferrer">Inside a recent enterprise session with Techanzy <Icon/></a></section>
  <section class="about section-pad" id="about" data-nori-scene="about"><span id="experience" class="legacy-anchor" aria-hidden="true"></span><div class="section-kicker"><span>06 / THE PERSON BEHIND THE PROMPTS</span><span>ALWAYS A LEARNER.</span></div><div class="about-layout"><div class="about-intro"><h2>A builder’s mind.<br/>A teacher’s <em>heart.</em></h2><div class="about-portrait"><img src="/images/portrait.webp" alt="Salmon Joy, AI engineer and educator." width="800" height="800" loading="lazy"/><span class="nori-anchor" aria-hidden="true"></span></div><p>I’m Salmon, an AI engineer and educator based in Mumbai. I work where technical ideas meet the people who use them.</p><p>From engineering classrooms to enterprise AI systems, one thread connects my work: making complex technology useful, understandable, and worth exploring.</p><a href="/Salmon%20Joy%20Profile%202025%20(2).pdf" class="text-link">Download trainer profile <span>↓</span></a><small class="download-note">2025 profile · some historical details</small><a href="/about/" class="text-link">Read my full profile <Icon size={18}/></a></div><ol class="timeline">{milestones.map(([date,title,body])=><li><span class="eyebrow">{date}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div><div class="credentials"><div><span class="eyebrow">CONTINUING TO LEARN</span><a href="https://www.credly.com/badges/f92e7aac-3208-4609-8a77-29874ae0239c/public_url" target="_blank" rel="noopener noreferrer">AWS Academy Graduate — Cloud Architecting ↗</a><a href="https://www.credly.com/badges/cd51aa97-f351-429d-85f5-700c92b80cea/public_url" target="_blank" rel="noopener noreferrer">AWS Academy Graduate — Cloud Foundations ↗</a><a href="https://www.coursera.org/account/accomplishments/records/85EN8MXYGUSV" target="_blank" rel="noopener noreferrer">Google Cloud Big Data & ML Fundamentals ↗</a></div><div><span class="eyebrow">GIVING KNOWLEDGE FORWARD</span><h3>Yogdaanam Foundation</h3><p>Volunteering as a Technical Trainer since 2019, supporting social service and digital education.</p></div></div></section>
  <section class="insights section-pad" id="insights" data-nori-scene="ideas"><div class="section-kicker"><span>07 / A FEW THINGS ON MY MIND</span><span>AI FOR THE LAZY GENIUS</span></div><div class="section-heading"><h2>Big ideas.<br/><em>Human explanations.</em></h2><div><p>Practical guides for the work in front of you. More ideas in my newsletter, AI for the Lazy Genius.</p><a class="text-link" href="https://www.linkedin.com/newsletters/7300788113734307840/" target="_blank" rel="noopener noreferrer">Read & subscribe <Icon size={18}/></a></div></div><div class="article-grid">{insights.map((article,i)=><a class:list={['article-card',{featured:i===0}]} href={`/insights/${article.slug}/`}><div class="article-art" aria-hidden="true"><span>{article.symbol}</span><i></i><i></i></div><div class="article-text"><span class="eyebrow">{article.topic}</span><h3>{article.title}</h3><p>{article.description}</p><span class="text-link">A little food for thought <Icon size={18}/></span></div></a>)}</div><a class="text-link" href="/insights/">Explore the practical AI guides <Icon/></a><div class="insight-bottom"><a class="text-link" href="https://www.youtube.com/@ai.4.lazygenius" target="_blank" rel="noopener noreferrer">More of a visual learner? Watch the videos <Icon/></a><span class="nori-anchor" aria-hidden="true"></span></div></section>
  <section class="contact dark-scene section-pad" id="contact" data-nori-scene="contact"><div class="section-kicker"><span>08 / FROM CURIOSITY TO CAPABILITY</span><span>LET’S MAKE IT PRACTICAL.</span></div><div class="contact-layout"><div class="contact-intro"><h2>Your team.<br/>Their potential.<br/><em>A little AI.</em></h2><p>Let’s build the confidence and capability to put AI to work.</p><div class="contact-direct"><a href="mailto:salmonjoy1996@gmail.com">salmonjoy1996@gmail.com <Icon size={18}/></a><span>Training · Consulting · Speaking</span></div><span class="nori-anchor" aria-hidden="true"></span></div><Enquiry/></div></section>
</Layout>
