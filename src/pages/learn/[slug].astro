---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LessonActivity from '../../components/LessonActivity.astro';
import {lessons} from '../../data/lessons';
import {reusableBrief} from '../../data/lesson-fixtures';
import {PERSON_ID,SITE} from '../../data/seo';
import '../../styles/lessons.css';
export function getStaticPaths(){return lessons.map(lesson=>({params:{slug:lesson.slug},props:{lesson}}));}
const {lesson}=Astro.props;
const path=`/learn/${lesson.slug}/`;
const breadcrumbs=[{name:'Home',path:'/'},{name:'Learn',path:'/learn/'},{name:lesson.title,path}];
const next=lessons[(lessons.findIndex(l=>l.id===lesson.id)+1)%lessons.length];
const entity={'@type':'LearningResource','@id':SITE+path+'#lesson',name:lesson.title,description:lesson.description,url:SITE+path,inLanguage:'en',isAccessibleForFree:true,learningResourceType:'Interactive lesson',educationalUse:'Self-guided learning',audience:{'@type':'Audience',audienceType:lesson.audience},author:{'@id':PERSON_ID},...(lesson.publishedAt?{datePublished:lesson.publishedAt}:{}),mainEntityOfPage:{'@id':SITE+path+'#webpage'},isPartOf:{'@id':SITE+'/#website'}};
---
<Layout lesson title={`${lesson.title} | Interactive GenAI Lesson | Salmon Joy`} description={lesson.description} breadcrumbs={breadcrumbs} entities={[entity]} image={`/images/${lesson.art}.png`} imageAlt={`${lesson.title} — learn GenAI with Salmon Joy`} enquiryTrack={lesson.track}>
 <section class="learn-hero"><Breadcrumbs items={breadcrumbs}/><span class="eyebrow">{lesson.number} / {lesson.audience}</span><h1>{lesson.title}</h1><p>{lesson.opening}</p><div class="learn-meta"><a href="/about/">Taught by Salmon Joy</a><span>{lesson.duration}</span><span>No account · No live AI</span>{lesson.publishedAt&&<time datetime={lesson.publishedAt}>{new Date(lesson.publishedAt+'T12:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>}</div><a class="button button-ivory" href="#activity" data-start-lesson>Let’s try it <span aria-hidden="true">↓</span></a></section>
 <div style={`--step-count:${lesson.steps.length}`}><LessonActivity lesson={lesson}/></div>
 <section class="lesson-end" id="lesson-takeaways"><span class="eyebrow">A FEW THINGS WORTH KEEPING</span><h2 tabindex="-1">Your small aha moments.</h2><ol class="lesson-takeaways">{lesson.takeaways.map((t,i)=><li><span>0{i+1}</span>{t}</li>)}</ol>{lesson.id==='rag'&&<div id="fixture-recap" aria-label="Your three fixture results"></div>}{lesson.id==='brief'&&<details class="recap-prompt"><summary>Your reusable brief</summary><pre id="copyable-prompt" class="static-prompt" tabindex="0">{reusableBrief}</pre><button type="button" class="quiet-action" data-copy-prompt>Copy prompt</button><p data-copy-status role="status"></p></details>}<p>{lesson.closing}</p><button type="button" class="quiet-action review-lesson" data-review-lesson>Review my choices</button><div class="lesson-end-links"><a class="button button-burgundy" href={`/learn/${next.slug}/`}>Try: {next.title} <span aria-hidden="true">↗</span></a><a class="text-link" href="#contact">{lesson.id==='brief'?'Discuss AI at Work training':lesson.id==='rag'?'Discuss Build with GenAI training':'Explore AI training'} <span aria-hidden="true">↗</span></a></div></section>
 <section class="lesson-sources"><h2>Keep exploring</h2><ul>{lesson.sources.map(s=><li><a href={s.url} target={s.url.startsWith('https:')?'_blank':undefined} rel={s.url.startsWith('https:')?'noopener noreferrer':undefined}>{s.label}</a></li>)}</ul><p><a class="text-link" href="/learn/">All three lessons <span aria-hidden="true">↗</span></a></p></section>
</Layout>
