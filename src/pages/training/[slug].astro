---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import {services} from '../../data/services';
import {tracks} from '../../data/training';
import {projects} from '../../data/content';
import {insights} from '../../data/articles';
import {SITE,PERSON_ID} from '../../data/seo';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service:s}=Astro.props;
const track=tracks.find(t=>t.id===s.id)!;
const project=projects.find(p=>p.slug===s.project)!;
const related=insights.filter(a=>a.relatedServices.includes(s.id));
const path=`/training/${s.slug}/`;
const breadcrumbs=[{name:'Home',path:'/'},{name:'Training',path:'/training/'},{name:track.title,path}];
const entity={'@type':'Service','@id':SITE+path+'#service',name:s.title,description:s.answer,provider:{'@id':PERSON_ID},url:SITE+path,serviceType:s.title,areaServed:[{'@type':'Country',name:'India'},'Live online for international teams'],mainEntityOfPage:{'@id':SITE+path+'#webpage'}};
---
<Layout title={`${s.title} | Salmon Joy`} description={s.description} breadcrumbs={breadcrumbs} entities={[entity]} enquiryTrack={s.id}>
<section class="editorial-hero dark-scene"><Breadcrumbs items={breadcrumbs}/><span class="eyebrow">{track.audience}</span><h1>{s.title}{' '}<span class="serif-line">From curiosity to capability.</span></h1><p>{s.answer}</p><a href="#contact" class="button button-ivory track-enquiry" data-track={s.id}>Discuss this programme <Icon/></a><p class="delivery-caption">On-site across India · Live online worldwide</p></section>
<section class="editorial-wrap"><div class="editorial-split"><article class="reading-copy"><h2>Who is this for?</h2><p>{s.audience}</p><h2>What should participants know first?</h2><p>{s.prerequisites}</p><h2>What will your team learn?</h2><ul>{track.outcomes.map(o=><li>{o}</li>)}</ul>{s.modules.map(m=><section class="content-section"><h3>{m.title}</h3><p>{m.body}</p></section>)}</article><aside class="evidence-panel"><span class="eyebrow">REPRESENTATIVE EXERCISE</span><h2>{s.exercise.title}</h2><ol>{s.exercise.steps.map(step=><li>{step}</li>)}</ol><p><strong>What you practise producing:</strong> {s.exercise.output}</p><small>Illustrative activity. The actual workshop scope is agreed with your team.</small></aside></div><div class="evidence-strip"><div><span class="eyebrow">EXPERIENCE BEHIND THE EXPLANATIONS</span><h2>Learn with a builder.</h2><p>{project.description}: {project.approach}</p><a class="text-link" href={project.featured?`/projects/${project.slug}/`:'/projects/'}>Explore the engineering work <Icon/></a></div><div><h3>See the evidence</h3><a class="text-link" href={s.evidence.url} target={s.evidence.url.startsWith('https')?'_blank':undefined} rel={s.evidence.url.startsWith('https')?'noopener noreferrer':undefined}>{s.evidence.label} <Icon/></a><p><a href="/about/">Salmon’s profile and programme affiliation →</a></p></div></div><section class="reading-copy faq-block"><span class="eyebrow">A FEW PRACTICAL QUESTIONS</span><h2>Before your workshop.</h2>{s.faqs.map(f=><details><summary>{f.q}<Icon name="plus" size={18}/></summary><p>{f.a}</p></details>)}</section>{related.length>0&&<section class="related-reading"><h2>A little preparation.</h2>{related.map(a=><a class="resource-link" href={`/insights/${a.slug}/`}><strong>{a.title}</strong><span>{a.description}</span><Icon/></a>)}</section>}<a class="text-link" href="/training/">Compare all training paths <Icon/></a></section>
</Layout>
