---
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/technical.css';
import {theme,themeName,themeCSS} from '../data/theme';
import '@fontsource-variable/manrope';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Icon from '../components/Icon.astro';
import NoriFallback from '../components/NoriFallback.astro';
import Enquiry from '../components/Enquiry.astro';
import {SITE,pageGraph,type SeoMetadata} from '../data/seo';
import type {TrackId} from '../data/training';
interface Props extends SeoMetadata { home?: boolean; enquiryTrack?: TrackId; }
const { title = 'Salmon Joy | AI Expert & Corporate AI Trainer in India', description = 'Practical corporate AI training with Salmon Joy, AI engineer and OpenAI Programme Master Trainer. 10,000+ learners trained. On-site in India and live online.', home = false, image = '/og.png', imageAlt='Salmon Joy — AI, made practical.', noindex=false, enquiryTrack } = Astro.props;
const canonical = new URL(Astro.props.canonicalPath||Astro.url.pathname, SITE);
const socialImage = new URL(image,SITE);
const graph = pageGraph(Astro.props,Astro.url.pathname,title,description);
const prefix = home ? '' : '/';
---
<!doctype html>
<html lang="en" data-theme={themeName}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.dark} /><meta name="description" content={description} />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'} />
    <meta property="og:type" content={Astro.props.entities?.some(e=>e['@type']==='Article')?'article':'website'} /><meta property="og:site_name" content="Salmon Joy" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta property="og:image:alt" content={imageAlt}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image:alt" content={imageAlt}/>
    {Astro.props.publishedAt && <meta property="article:published_time" content={Astro.props.publishedAt}/>}{Astro.props.modifiedAt && <meta property="article:modified_time" content={Astro.props.modifiedAt}/>}
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')} />
    <title>{title}</title>
    <style is:inline set:html={themeCSS}/>
  </head>
  <body class:list={[home ? 'home-page' : 'inner-page']}>
    <div class="story-thread" aria-hidden="true"><i></i></div><a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <a href="/" class="wordmark" aria-label="salmonjoy home">salmon<span>joy</span><i aria-hidden="true">✦</i></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href={`${prefix}#training`}>Training</a><a href={`${prefix}#work`}>Work</a><a href={`${prefix}#about`}>About</a><a href={`${prefix}#insights`}>Ideas</a></nav>
      <div class="header-actions"><button class="motion-toggle" data-motion-toggle aria-pressed="false" aria-label="Pause animations"><span class="motion-icon">Ⅱ</span><span class="motion-label">Motion on</span></button><a class="header-contact" href={`${prefix}#contact`}>Let’s talk <Icon size={16} /></a><button id="menu-open" class="menu-toggle" aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false"><span></span><span></span></button></div>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Site navigation"><div class="dialog-top"><span class="eyebrow">EXPLORE THE STUDIO</span><button data-close-dialog aria-label="Close navigation"><Icon name="close" /></button></div><nav aria-label="Mobile navigation"><a href={`${prefix}#training`}>Training <span>01</span></a><a href={`${prefix}#work`}>Work <span>02</span></a><a href={`${prefix}#about`}>About <span>03</span></a><a href={`${prefix}#insights`}>Ideas <span>04</span></a><a href={`${prefix}#contact`}>Let’s talk <Icon /></a></nav><p>From curiosity to capability.</p></dialog>
    <main id="main"><slot />{!home && <section class="inner-contact dark-scene" id="contact"><div><span class="eyebrow">LET’S MAKE IT PRACTICAL.</span><h2>Curious about<br/><em>what comes next?</em></h2><p>Tell me what your team wants to achieve.</p></div><Enquiry selectedTrack={enquiryTrack}/></section>}</main>
    <footer class="site-footer"><div class="footer-top"><a class="wordmark" href="/">salmon<span>joy</span><i>✦</i></a><p>Curiosity is a good place to start.</p><a href="#main" class="back-top">Back to top ↑</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Salmon Joy · Mumbai, India</span><nav aria-label="Social and legal links"><a href="https://www.linkedin.com/in/salmonjoy/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.linkedin.com/newsletters/7300788113734307840/" target="_blank" rel="noopener noreferrer">Newsletter ↗</a><a href="https://github.com/SalmonJoy" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="mailto:salmonjoy1996@gmail.com">Email ↗</a><a href="/training/">Training</a><a href="/about/">Profile</a><a href="/insights/">Guides</a><a href="/privacy/">Privacy</a></nav></div></footer>
    <div class="companion-controls"><button class="motion-toggle bottom-motion" data-motion-toggle aria-pressed="false" aria-label="Pause animations"><span class="motion-icon">Ⅱ</span><span class="motion-label">Motion on</span></button><button id="guide-open" class="guide-open" aria-label="A little guidance? Meet Nori, your site guide" aria-controls="guide-dialog"><span id="nori-dock"></span><span class="guide-button-copy">A little guidance?<small>Meet Nori</small></span><span class="guide-plus" aria-hidden="true">+</span></button><a class="mobile-training-cta" href={`${prefix}#contact`}>Discuss training <Icon size={16} /></a></div>
    <button id="nori-host" class="nori-host" data-open-guide aria-label="Open Nori’s guide"><NoriFallback /><canvas id="nori-canvas" aria-hidden="true"></canvas></button>
    <dialog id="guide-dialog" class="guide-dialog" aria-label="Nori, your site guide"><div class="dialog-top"><div><span class="eyebrow">A LITTLE GUIDANCE</span><h2>Hi, I’m <em>Nori.</em></h2></div><button data-close-dialog aria-label="Close Nori’s guide"><Icon name="close" /></button></div><p class="guide-intro">Curious about AI? You’re in the right place. Let’s find something useful for you.</p><div class="guide-links"><a href={`${prefix}#teaching`}>See how Salmon teaches <Icon size={18} /></a><a href="/projects/">Explore 21 AI projects <Icon size={18} /></a><a href={`${prefix}#contact`}>Start a conversation <Icon size={18} /></a></div><hr/><h3>Find your training path</h3><form id="finder-form"><label>Who is the training for?<select name="audience"><option value="work">Business teams & professionals</option><option value="build">Engineers & developers</option><option value="teach">Educators & students</option></select></label><label>What would you like to achieve?<input name="finderGoal" placeholder="e.g. build useful AI workflows" maxlength="300" required /></label><label>How many people?<select name="finderSize"><option>1–10 people</option><option>11–50 people</option><option>51+ people</option></select></label><button class="button button-burgundy" type="submit">Find my programme <Icon /></button></form><div id="finder-result" class="finder-result" hidden aria-live="polite"><span class="eyebrow">YOUR STARTING POINT</span><h3 id="finder-title"></h3><p id="finder-description"></p><a id="finder-contact" class="text-link" href={`${prefix}#contact`}>Discuss this programme <Icon size={18}/></a></div><p class="guide-disclaimer">A curated guide to Salmon’s work and training.</p></dialog>
    <script>import '../scripts/main';</script>
  </body>
</html>
